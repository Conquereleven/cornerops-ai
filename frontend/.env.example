VITE_API_BASE_URL=
# Supabase Auth: public URL and publishable key only. Never a secret or service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_GOOGLE_AUTH_ENABLED=false

# Public site identity and contact. All optional; defaults are the current public channels.
# Set VITE_PUBLIC_SITE_URL only after the Founder has chosen the domain (https origin, no path).
VITE_PUBLIC_SITE_URL=
VITE_PUBLIC_BOOKING_URL=
VITE_PUBLIC_CONTACT_EMAIL=
VITE_PUBLIC_WHATSAPP_NUMBER=
VITE_PUBLIC_LINKEDIN_URL=
# Leave empty until real legal documents exist; the footer shows no link without them.
VITE_PUBLIC_PRIVACY_URL=
VITE_PUBLIC_TERMS_URL=
