OPENCLAW_REQUIRE_APPROVAL=true
OPENCLAW_AUDIT_ENABLED=true
OPENCLAW_ALLOWED_CHANNELS=whatsapp,telegram,slack
OPENCLAW_ALLOWED_USERS=
OPENCLAW_ALLOWED_TOOLS=
